<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:startColor="@color/primary"
                android:endColor="@color/accent_gradient_end" />
            <stroke
                android:width="2dp"
                android:color="@color/focus" />
            <padding
                android:left="18dp"
                android:top="16dp"
                android:right="18dp"
                android:bottom="16dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:startColor="@color/surface_elevated"
                android:endColor="@color/surface_accent" />
            <stroke
                android:width="1dp"
                android:color="@color/color_border" />
            <padding
                android:left="18dp"
                android:top="16dp"
                android:right="18dp"
                android:bottom="16dp" />
        </shape>
    </item>
</selector>
