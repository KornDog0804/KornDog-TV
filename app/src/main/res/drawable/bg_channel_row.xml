<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/primary_surface"
                android:endColor="@color/surface_emphasis" />

            <stroke
                android:width="2dp"
                android:color="@color/primary_light" />

            <corners android:radius="12dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_emphasis" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/surface_elevated"
                android:endColor="@color/surface" />

            <stroke
                android:width="1dp"
                android:color="@color/color_border" />

            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
